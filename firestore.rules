rules_version = '2';
// כללי האבטחה של מאגר האתר (Firebase → Firestore Database → Rules).
// • users/{uid}: כל תלמיד רואה ועורך רק את הכרטיס של עצמו. רק המורה רואה את כולם.
// • daily/{יום}: מונים אנונימיים (ביקורים, צפיות). כל אחד יכול רק להוסיף, רק המורה יכול לקרוא.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['orelpinchasi@gmail.com'];
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','grade','units','school','phone','updates','updatesAt','consentAt',
                               'email','createdAt','done','undone','days','last','doneCount','lastSeen'])
        && (!('name' in d)   || (d.name is string && d.name.size() <= 40))
        && (!('school' in d) || (d.school is string && d.school.size() <= 60))
        && (!('phone' in d)  || (d.phone is string && d.phone.size() <= 20))
        && (!('email' in d)  || d.email == request.auth.token.email);
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validUser();
      allow delete: if isOwner(uid) || isAdmin();
    }

    function counters() { return ['visits','newVisitors','plays','v','src','gate','signups','lesson']; }
    function validDay(d) {
      return d.keys().hasOnly(counters())
        && (!('v' in d)   || d.v.size() <= 3000)
        && (!('src' in d) || d.src.size() <= 60);
    }
    match /daily/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$') && validDay(request.resource.data);
      allow update: if validDay(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(counters());
      allow delete: if isAdmin();
    }
  }
}
