rules_version = '2';
// כללי האבטחה של מאגר התלמידים (Firebase → Firestore Database → Rules).
// כל תלמיד רואה ועורך רק את הכרטיס של עצמו. רק המורים ברשימה למטה רואים את כולם.
// ⚠️ להחליף את TEACHER@gmail.com במייל שלכם (אותו מייל כמו ב-firebase-config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['TEACHER@gmail.com'];
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','grade','units','school','phone','updates','updatesAt','consentAt',
                               'email','createdAt','done','undone','days','last','doneCount','lastSeen'])
        && (!('name' in d)   || (d.name is string && d.name.size() <= 40))
        && (!('school' in d) || (d.school is string && d.school.size() <= 60))
        && (!('phone' in d)  || (d.phone is string && d.phone.size() <= 20))
        && (!('email' in d)  || d.email == request.auth.token.email);
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validUser();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
